# ── Identity ────────────────────────────────────────────────────────────────
GROUP_ID=1

# ── Client data paths ───────────────────────────────────────────────────────
VIDEO_PATH=/data/test_video.mp4
GROUND_TRUTH_PATH=/data/ground_truth.csv
MODEL_PATH=/data/yolov10n.onnx
RESULTS_LOG_PATH=/data/results.csv
RESULTS_BY_PHASE_PATH=/data/results_by_phase.csv

# ── Remote inference ────────────────────────────────────────────────────────
# The preferred path sends compressed JPEG frames through the Router VM to the
# GPU inference API, avoiding a large FP32 tensor transfer for every frame.
REMOTE_INFERENCE_URL=http://172.22.174.148:8100
REMOTE_JPEG_QUALITY=80
REMOTE_INFERENCE_TIMEOUT_SEC=12.0
REMOTE_FAILURE_COOLDOWN_SEC=3.0
REMOTE_FALLBACK_TO_LOCAL=true

# Used only when REMOTE_INFERENCE_URL is blank.
TRITON_URL=172.22.174.148:8001
TRITON_MODEL_NAME=yolov10n

# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BROKERS=172.22.174.149:9092
APP_METRICS_TOPIC=dnn_partition.client_metrics
KAFKA_GPU_TOPIC=dnn_partition.server_metrics
KAFKA_NET_TOPIC=edgelab.network.metrics
KAFKA_PHASE_TOPIC=edgelab.phase
KAFKA_CONTROL_TOPIC=edgelab.placement.control

# ── Inference and scoring ───────────────────────────────────────────────────
INITIAL_PROCESSING_MODE=local
FRAME_INTERVAL_MS=100
MODEL_INPUT_WIDTH=640
MODEL_INPUT_HEIGHT=640
QUEUE_MAX_SIZE=10

CONFIDENCE_THRESHOLD=0.25
# COCO classes for this red-car video. YOLO sometimes labels it as truck.
TARGET_CLASS_ID=2,7
# Keeps the edited red-car video detected across the full clip.
TARGET_CONFIDENCE_THRESHOLD=0.1

MISS_PENALTY_PX=100.0
LATENCY_DEADLINE_MS=300
LOG_LEVEL=INFO
OTLP_ENDPOINT=

# ── Warm-up spike exclusion ─────────────────────────────────────────────────
# One outlier latency sample right after a phase transition (a backend
# absorbing newly-applied load) is kept out of the score and the charts. The
# SP-Agent still sees the real value on Kafka, so placement decisions can
# react to it. Leave WARMUP_SPIKE_PHASES blank to arm on every transition;
# name phases to restrict it (e.g. "gpu_load").
WARMUP_SPIKE_FILTER_ENABLED=true
WARMUP_SPIKE_PHASES=
WARMUP_SPIKE_SETTLE_SEC=2.0
WARMUP_SPIKE_MULTIPLIER=3.0
WARMUP_SPIKE_FLOOR_MS=150.0

# ── SP-Agent ────────────────────────────────────────────────────────────────
# false = the SP-Agent controls placement. Set true only to enable dashboard
# Local/Remote/Auto controls for manual-placement experiments. Local and
# Remote lock placement; Auto releases the lock and returns control to the
# SP-Agent.
MANUAL_PLACEMENT_CONTROL=false

# student loads client/student/sp_agent.py (the graded submission template).
# example loads client/student/sp_agent_example.py (the reference strategy).
SP_AGENT_CLASS=student
SP_AGENT_INTERVAL_MS=500
SP_AGENT_DEBUG_METRICS=false

# Low-rate inactive-backend probes keep both latency cards current and let an
# SP-Agent recover from local to remote after a transient remote spike. They
# populate self.last_remote_probe_* for every agent, not just the reference
# one. A probe never runs while the pipeline is mid-inference, so it does not
# inflate the latency a frame is scored on. 10 seconds keeps overhead low.
LATENCY_PROBES_ENABLED=true
LATENCY_PROBE_INTERVAL_SEC=10.0

# ── Cycle collection ────────────────────────────────────────────────────────
# manual: click Start collection, then wait for the next cycle_start message.
# wait_for_cycle: automatically collect from the next cycle_start message.
# off: collect continuously; intended only for development.
SYNC_MODE=manual

# Safety net: finalise a cycle that never reaches cycle_end.
PHASE_TIMEOUT_SEC=300

# Mounted read-only by Docker from ./seqam.
SCENARIO_PATH=/scenario/ExperimentConfig.json

# ── Dashboard ───────────────────────────────────────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_URL=http://localhost:8080
# Higher preview FPS or resolution competes with local YOLO inference on the Pi.
DASHBOARD_FPS=10
DASHBOARD_JPEG_QUALITY=60
DASHBOARD_FRAME_WIDTH=640

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_MAX_HISTORY=300
DASHBOARD_WEBSOCKET_FPS=2
DASHBOARD_ACCESS_LOG=false
# Leave blank to use http://<pi-host>:8080.
DASHBOARD_PUBLIC_API_URL=
