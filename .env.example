# Identity
GROUP_ID=1

# Paths
VIDEO_PATH=/data/test_video.mp4
GROUND_TRUTH_PATH=/data/ground_truth.csv
MODEL_PATH=/data/yolov10n.onnx

# Remote inference
# Preferred path: the Pi sends a compressed JPEG to the Router VM, which forwards
# :8100 to the remote inference API on the GPU server. That API decodes and
# preprocesses locally before calling Triton, avoiding a 4.9 MB FP32 tensor over
# the network on every frame.
REMOTE_INFERENCE_URL=http://172.22.174.148:8100
REMOTE_JPEG_QUALITY=80
REMOTE_INFERENCE_TIMEOUT_SEC=1.5
# After a timeout/error, is_available() reports unavailable for this long so the
# Dispatcher skips straight to local instead of blocking on remote again every frame.
REMOTE_FAILURE_COOLDOWN_SEC=3.0

# Legacy direct Triton gRPC fallback. Used by the client only when
# REMOTE_INFERENCE_URL is blank. During network experiments this must also go via
# the Router VM, not directly to the GPU server.
TRITON_URL=172.22.174.148:8001
TRITON_MODEL_NAME=yolov10n

# Kafka
KAFKA_BROKERS=172.22.174.149:9092
# Eldiyar's real GPU/Triton server metrics topic. Do not change this unless
# Eldiyar's kafka_metrics_publisher.py on 172.22.174.145 is reconfigured.
KAFKA_GPU_TOPIC=dnn_partition.server_metrics
# Network conditions topic published by network_conditions_publisher.py on the Network VM.
# This topic will not exist until that script is started on 172.22.174.148.
# The app handles missing messages safely (defaults to zero delay/loss).
KAFKA_NET_TOPIC=edgelab.network.metrics
# Experiment phase topic published by tc_controller.py on the Network VM.
# This topic will not exist until that script is started on 172.22.174.148.
# The app defaults to phase="baseline" until a message arrives.
KAFKA_PHASE_TOPIC=edgelab.phase

# OpenTelemetry
OTLP_ENDPOINT=

# Behavior
INITIAL_PROCESSING_MODE=local
FRAME_INTERVAL_MS=100
MODEL_INPUT_WIDTH=640
MODEL_INPUT_HEIGHT=640
# Set to true to print GPU/network/phase metrics to the terminal every ~2 seconds.
# Useful when troubleshooting Kafka connectivity or unexpected agent behaviour.
# Leave false during normal student experiments.
SP_AGENT_DEBUG_METRICS=false
RESULTS_LOG_PATH=/data/results.csv
# Defaults to RESULTS_LOG_PATH with "_by_phase" added before the extension.
RESULTS_BY_PHASE_PATH=/data/results_by_phase.csv
QUEUE_MAX_SIZE=10
CONFIDENCE_THRESHOLD=0.3
# COCO vehicle classes for the drone-view car video.
# car=2, bus=5, truck=7 — all vehicle classes; covers frames where YOLO
# misclassifies the car as bus or truck from certain angles.
TARGET_CLASS_ID=2,5,7
TARGET_CONFIDENCE_THRESHOLD=0.1
SP_AGENT_INTERVAL_MS=500
LOG_LEVEL=INFO
# Penalty added to the cumulative score when the model returns no detection (0,0)
# but ground truth has a real target position. Without this, missed detections are
# scored as distance-from-origin (~1000-1500px), which dominates the score and
# makes placement quality invisible. Set to 0 to skip missed-detection frames
# entirely. Default: 100.0
MISS_PENALTY_PX=100.0

# Auto-stop: if true, app waits for a phase message from Kafka,
# runs through one full experiment cycle (all 5 phases), then stops.
# Set to false for development (runs until Ctrl+C).
AUTO_STOP=true
# Safety timeout for AUTO_STOP phase monitoring. Set 0 to disable.
PHASE_TIMEOUT_SEC=300

# Optional browser dashboard publisher (client and dashboard run on the same Pi)
DASHBOARD_ENABLED=true
DASHBOARD_URL=http://localhost:8080
DASHBOARD_FPS=10
DASHBOARD_JPEG_QUALITY=75
DASHBOARD_FRAME_WIDTH=960

# Dashboard backend (on the same Pi, one deployment per group)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_MAX_HISTORY=300
# Set true only when debugging HTTP request flow; frame/image requests are noisy.
DASHBOARD_ACCESS_LOG=false
# Optional browser-facing override. Leave blank to use http://<pi-host>:8080.
DASHBOARD_PUBLIC_API_URL=
# Client app metrics topic. Each group's Pi publishes scored frame records here
# and the SP agent subscribes to read back its own latency measurements.
# All groups share this topic; the SP agent filters messages by group_id.
# Defaults to dnn_partition.client_metrics when left blank.
APP_METRICS_TOPIC=dnn_partition.client_metrics

# GPU metrics publisher (on GPU server only)
TRITON_METRICS_URL=http://localhost:8002/metrics
NVIDIA_SMI_PATH=/usr/bin/nvidia-smi
POLL_INTERVAL_SEC=1

# Network conditions publisher (on Network VM only)
# The Network VM (172.22.174.148) uses interface ens18.
NETWORK_INTERFACE=ens18
# Path to the phase file written by SeQaM (or manually) on the Network VM.
# When running as a plain Python script directly on the VM, /tmp is accessible.
PHASE_FILE=/tmp/edgelab_phase
PHASE_POLL_INTERVAL_SEC=0.1
